/* fling TUI styles — main application layout */

/* Top-level horizontal split */
#main-layout {
    width: 1fr;
    height: 1fr;
}

/* Sidebar: collection tree on the left */
#sidebar {
    width: 35;
    min-width: 20;
    max-width: 60;
    height: 1fr;
    border-right: solid $surface-lighten-2;
    padding: 0;
}

/* Content area: takes remaining horizontal space */
#content {
    width: 1fr;
    height: 1fr;
}

/* Collection tree fills the sidebar */
#collection-tree {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

/* Environment selector at bottom of sidebar */
#env-select {
    width: 1fr;
    margin: 0 1;
}

/* Request panel: top half of content */
#request-panel {
    height: 1fr;
}

/* Tabbed content inside request panel */
#request-tabs {
    height: 1fr;
}

/* Response panel: bottom half of content */
#response-panel {
    height: 1fr;
}

/* Progress panel: replaces response panel during Run All */
#progress-panel {
    height: 1fr;
}

/* Progress bar inside progress panel */
#run-progress-bar {
    margin: 0 2;
}

/* Request status table inside progress panel */
#request-status-table {
    height: 1fr;
}
